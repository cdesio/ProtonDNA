/control/verbose 1
/det/setWorldHalfSize 10 cm
# Grid is centred on z; entrance face is z=0.
/det/setVoxelSize 300 nm
/det/setGrid 8 8 50
/det/setMaxStep 30 nm
/det/checkOverlaps false
/tracking/killSecondaries false
/tracking/recordSecondaries true
/primary/particle proton
/primary/energy 150 MeV
# Start 10 um before the grid front; avoid voxel-column boundaries.
/primary/position 0.15 0.15 0 um
/primary/direction 0 0 1
/run/initialize
/run/printProgress 100
/run/beamOn 1
